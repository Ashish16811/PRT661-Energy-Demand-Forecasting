# -----------------------------------------------------------------------------
# Local development
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/runtime/portal.db
PORT=8050
PORTAL_ROLE=local
PORTAL_DEFAULT_REGION=NSW1
PORTAL_TIMEZONE=Australia/Adelaide
PREDISPATCH_CACHE_MAX_AGE_MINUTES=90

# -----------------------------------------------------------------------------
# Railway WEB service
# Set in Railway Variables (do not paste Railway secrets into this file):
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# PORTAL_ROLE=web
# PORTAL_DEFAULT_REGION=NSW1
# PORTAL_TIMEZONE=Australia/Adelaide
# TZ=UTC
#
# Start command:
# gunicorn app.app:server --bind 0.0.0.0:$PORT --workers 1 --threads 4 --timeout 180
# Healthcheck path: /healthz
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Railway WORKER service
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# PORTAL_ROLE=worker
# DATA_DIR=/app/storage/data
# MODEL_DIR=/app/storage/models
# WORKER_STORAGE_DIR=/app/storage
# WORKER_ASSET_ARCHIVE=/app/storage/PRT661_WORKER_ASSETS.tar.gz
# Optional instead of CLI volume upload (for example, a public GitHub Release asset):
# WORKER_ASSET_URL=https://.../PRT661_WORKER_ASSETS.tar.gz
# WORKER_ASSET_SHA256=<sha256 printed by tools/build_worker_assets.py>
# DELETE_ASSET_ARCHIVE_AFTER_EXTRACT=1
# RUN_STARTUP_JOBS=1
# OPERATIONAL_MINUTES=5,35
# HOURLY_MINUTE=15
# PREDISPATCH_CACHE_MAX_AGE_MINUTES=90
# TZ=UTC
#
# Attach a Railway Volume at /app/storage.
# Start command: python -m pipeline.railway_worker
# -----------------------------------------------------------------------------
